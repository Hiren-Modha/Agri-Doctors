# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.

WATSONX_API_KEY=PASTE_YOUR_IBM_API_KEY_HERE
WATSONX_PROJECT_ID=PASTE_YOUR_PROJECT_ID_HERE
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Vision model — used by the Pathologist Agent (image analysis)
WATSONX_VISION_MODEL=mistralai/mistral-small-3-1-24b-instruct-2503

# Text model — used by the Extension Officer Agent (advisory generation)
WATSONX_TEXT_MODEL=ibm/granite-4-h-small
